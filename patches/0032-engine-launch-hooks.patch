+            try {
+                return handleIntentInternal(intent, isNew, restore, fromPassword, progress, rebuildFragments, openedTelegram);
+            } finally {
+                app.exteraless.plugins.intents.IntentsDispatcher.dispatchAfter(pluginContext);
+            }
+        }
+        return handleIntentInternal(intent, isNew, restore, fromPassword, progress, rebuildFragments, openedTelegram);
+    }
