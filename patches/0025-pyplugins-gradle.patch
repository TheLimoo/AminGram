+// AminGram (M0): Chaquopy Python runtime for the .plugin engine.
+// Plugin on the library module (exactly one module per app):
+// Python source lives in TMessagesProj/src/main/python/ and is
+// delivered by the overlay copy. Python 3.11 is pinned: it is the
+// last version with 32-bit ABI support (3.12+ is 64-bit only), so
+// the afat flavor's armeabi-v7a slice still builds. buildPython
+// must match the runtime version on the build machine (CI installs
+// Python 3.11 via actions/setup-python).
+chaquopy {
+    defaultConfig {
+        version "3.11"
+        buildPython "python3.11"
+        // AminGram (Fix 8 / v3.0.8): elyx_runtime imports PyYAML at
+        // top level (archive/assets/localization/metadata/namespace),
+        // and pip_controller lazily imports requests +
+        // packaging.version (plugin_loader disables mini-pip when
+        // they are absent). Without a pip block the requirements
+        // .imy files ship empty (22 bytes) and installing any .elyx
+        // fails with "elyx_runtime unavailable". debugpy is NOT
+        // installed: dev_server imports it inside try/except and
+        // degrades cleanly. No beautifulsoup4/lxml/pillow: no
+        // unguarded SDK import needs them.
+        // AminGram (Fix 9 / v3.0.9): ZwyLib 3.1.0 imports
+        // typing_extensions in utils/java_utils.py, autoupdate/
+        // updater.py and commands/manager.py (unguarded, top level).
+        // Without it ZwyLib fails to import, MSL's guarded zwylib
+        // import falls to its RecursiveMock branch (which never
+        // defines SettingEntry) and the plugin dies at line 119 with
+        // NameError: name 'SettingEntry' is not defined. A plugin
+        // dependency's own imports are part of the pip surface —
+        // sweep plugin deps, not just the SDK.
+        pip {
+            install "PyYAML"
+            install "requests"
+            install "packaging"
+            install "typing_extensions"
+        }
+        // AminGram (M4): bytecode compilation is Chaquopy's
+        // default, but only as a best-effort warning — when it
+        // fails, the app still builds and compiles on the phone
+        // (slower startup, more storage). src = true makes it a
+        // REQUIRED build step: the build fails instead of shipping
+        // uncompiled sources. stdlib ships pre-compiled already
+        // (stdlib-pyc.zip), so this only covers our own sources.
+        pyc {
+            src = true
+        }
+    }
+}
